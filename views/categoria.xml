<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- VISTA LISTA -->
    <record model="ir.ui.view" id="biozon.category_list">
      <field name="name">biozon category list</field>
      <field name="model">biozon.category</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="product_count"/>
        </tree>
      </field>
    </record>

    <!-- VISTA FORMULARIO -->
    <record model="ir.ui.view" id="biozon.category_form">
      <field name="name">biozon category form</field>
      <field name="model">biozon.category</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="name"/>
            <field name="description"/>
            <field name="product_count" readonly="1"/>
          </group>
          <group>
            <field name="products"/>
          </group>
        </form>
      </field>
    </record>

    <!-- VISTA KANBAN -->
    <record model="ir.ui.view" id="biozon.category_kanban">
      <field name="name">biozon category kanban</field>
      <field name="model">biozon.category</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="name"/>
          <field name="product_count"/>

          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click">
                <div><strong><field name="name"/></strong></div>
                <div><span>Productos: </span><field name="product_count"/></div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- ACCIÓN -->
    <record model="ir.actions.act_window" id="biozon.action_category_window">
      <field name="name">Categorías</field>
      <field name="res_model">biozon.category</field>
      <field name="view_mode">kanban,tree,form</field>
    </record>

  </data>
</odoo>
